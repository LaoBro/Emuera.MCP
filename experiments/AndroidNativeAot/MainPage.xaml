<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
						 xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
						 x:Class="Emuera.AndroidNativeAot.MainPage"
						 BackgroundColor="{StaticResource PageBackground}"
						 Title="Native AOT Probe">
		<Grid Padding="20" RowDefinitions="Auto,Auto,Auto,*,Auto" RowSpacing="12">
				<Label Grid.Row="0"
							 Text="Android Native AOT Probe"
							 FontSize="22"
							 FontAttributes="Bold"
							 TextColor="{StaticResource PrimaryText}" />
				<Label Grid.Row="1"
							 Text="MAUI workload + WebView + SAF"
							 FontSize="14"
							 TextColor="{StaticResource SecondaryText}" />
				<VerticalStackLayout Grid.Row="2" Spacing="8">
						<Button Text="选择文件（SAF）"
										Clicked="OnPickFileClicked"
										HorizontalOptions="Start" />
						<Label x:Name="StatusLabel"
									 Text="等待验证"
									 FontSize="13"
									 TextColor="{StaticResource SecondaryText}" />
				</VerticalStackLayout>
				<Border Grid.Row="3"
								Stroke="{StaticResource Accent}"
								StrokeThickness="1"
								Padding="1">
						<WebView x:Name="ProbeWebView" />
				</Border>
				<Label Grid.Row="4"
							 Text="仅用于构建、启动、WebView 和文件选择器冒烟，不是生产应用。"
							 FontSize="12"
							 TextColor="{StaticResource SecondaryText}" />
		</Grid>
</ContentPage>
