<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <RootNamespace>MinorShift.Emuera</RootNamespace>
    <AssemblyName>Emuera.Headless</AssemblyName>
    <DefineConstants>HEADLESS</DefineConstants>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ServerGarbageCollection>true</ServerGarbageCollection>
    <PublishSingleFile>true</PublishSingleFile>
    <!-- I-12 阶段 1：质量护栏按路径分级
         - Emuera.Headless/Shared/** 历史共享源码警告由 .editorconfig 全局抑制（T-023 物理迁移自 Emuera/）
         - Emuera.Headless/** 自有源码保持警告可见，便于阶段 2 逐步收紧
         - 阶段 2（Nullable enable + TreatWarningsAsErrors）待 T-022 推进 -->
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisMode>Minimum</AnalysisMode>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>

  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Emuera.Headless.Tests" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="System.CommandLine" Version="2.0.9" />
    <!-- I-14 阶段 C：System.Drawing.Common 已彻底移除
         通过自定义 Emu 类型（EmuColor/EmuPoint/EmuRectangle/EmuSize/EmuFont/EmuFontStyle/EmuRectangleF）
         + 隐式转换桥接 + #if HEADLESS 条件编译隔离 GDI 代码 -->
  </ItemGroup>
  <!-- ===== 共享源码：Shared/ 子树（T-023 物理迁移自 Emuera/） ===== -->
  <!-- 历史 Runtime/UI/Game 源码由 SDK 默认 glob（**\*.cs）自动包含 -->
  <!-- WinForms/音频专用文件（Sound.WMP/NAudio/NAudio_LoopStream/WinInput/Clipboard、
       WinFormsConsole/StringMeasure/EmueraConsole*.cs）留在 Emuera/ 原处作只读参考 -->
  <!-- .editorconfig [Emuera.Headless/Shared/**] 抑制历史警告；T-022 后逐步清零并启用 nullable -->

  <!-- ===== GlobalStatic：Headless 专用实现（不共享 Emuera/GlobalStatic.cs） ===== -->
  <!-- I-02：单会话不可变全局硬约束 + setter 断言 + Reset 清理，见 Emuera.Headless/GlobalStatic.cs -->

  <!-- ===== 嵌入资源：语言文件（SDK 默认 glob 不含 .xml，需显式包含） ===== -->
  <ItemGroup>
    <EmbeddedResource Include="Shared\Properties\lang\emuera-eng.xml" LinkBase="Properties\lang" />
    <EmbeddedResource Include="Shared\Properties\lang\emuera-zhs.xml" LinkBase="Properties\lang" />
  </ItemGroup>

  <!-- ===== issue 10：Vue 前端构建 + 静态资源服务 ===== -->
  <!-- wwwroot/ 文件随 build/publish 复制到输出目录。
       PublishSingleFile=true（PropertyGroup L13）下 wwwroot 是松散文件目录，不嵌入 exe，
       必须作为独立文件随 exe 分发。
       wwwroot/ 由 .gitignore 排除（构建产物不入库），由下面 BuildVueFrontend target 填充。
       注意：Content glob 在 project load 时评估，首次 build 时 wwwroot/ 尚为空，
       BuildVueFrontend target 内会直接 Copy 到 $(OutputPath)wwwroot/ 作为兜底。 -->
  <ItemGroup>
    <Content Include="wwwroot\**\*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- Vue 源码 + 配置文件，作为 BuildVueFrontend target 的 Inputs（用于增量检测）。
       必须用 ItemGroup 引用 @(VueSrcInputs)，不能直接在 Target Inputs 属性里写 glob——
       MSBuild 会把未展开的 glob 字面量当作"不存在的文件路径"，导致 Inputs/Outputs 增量失效。 -->
  <ItemGroup>
    <VueSrcInputs Include="..\Emuera.Web\src\**\*" />
    <VueSrcInputs Include="..\Emuera.Web\index.html" />
    <VueSrcInputs Include="..\Emuera.Web\package.json" />
    <VueSrcInputs Include="..\Emuera.Web\package-lock.json" />
    <VueSrcInputs Include="..\Emuera.Web\vite.config.ts" />
    <VueSrcInputs Include="..\Emuera.Web\tsconfig.json" />
  </ItemGroup>

  <!-- BuildVueFrontend: 增量跑 npm run build（src 比 dist 新才触发）
       - SkipVueBuild=true 显式跳过（CI / 纯 C# 改动场景）
       - DesignTimeBuild=true 跳过（IDE 设计时构建不触发，避免 IntelliSense 卡顿）
       - Node 不可用 → warning 跳过，不 fail build（Node.js 非项目必需依赖，README/CLAUDE.md 只列 .NET SDK + Python）
       - 用 MSBuild 原生 <Exec>，避免 Start-Process 重定向管道死锁（CLAUDE.md L33 警告）
       - Inputs/Outputs 增量：@(VueSrcInputs) 比 dist/index.html 新才触发 npm build（Vite 自身缓存够快） -->
  <Target Name="BuildVueFrontend"
          BeforeTargets="Build"
          Condition="'$(SkipVueBuild)' != 'true' And '$(DesignTimeBuild)' != 'true'"
          Inputs="@(VueSrcInputs)"
          Outputs="..\Emuera.Web\dist\index.html">

    <!-- Node 检测：IgnoreExitCode=true + Output ExitCode 让 npm 缺失时不 fail build -->
    <Exec Command="npm --version" ConsoleToMSBuild="true" IgnoreExitCode="true">
      <Output TaskParameter="ExitCode" PropertyName="NpmExitCode" />
    </Exec>

    <Warning Condition="'$(NpmExitCode)' != '0'"
             Text="npm not found in PATH; skipping Vue frontend build. Run 'npm install &amp;&amp; npm run build' in Emuera.Web/ manually to populate wwwroot/, or pass /p:SkipVueBuild=true to suppress this warning." />

    <!-- npm run build: Vite 自身有增量缓存，重复调用很快 -->
    <Exec Condition="'$(NpmExitCode)' == '0'"
          Command="npm run build"
          WorkingDirectory="..\Emuera.Web"
          ConsoleToMSBuild="true" />
  </Target>

  <!-- CopyVueFrontendToWwwroot: dist/ → wwwroot/（源树 + 输出目录）
       - 跑在 BuildVueFrontend 之后、Build 之前
       - SkipUnchangedFiles=true 避免每次 build 全量复制（按文件 mtime 增量）
       - 同时复制到 $(OutputPath)wwwroot/ 兜底首次 build（Content glob 还未评估到新文件）
       - 即便 BuildVueFrontend 因 Inputs/Outputs 跳过，本 target 仍会跑——
         这样手动 npm run build 后下一次 dotnet build 能 pick up 新 dist -->
  <Target Name="CopyVueFrontendToWwwroot"
          AfterTargets="BuildVueFrontend"
          BeforeTargets="Build"
          Condition="'$(SkipVueBuild)' != 'true' And '$(DesignTimeBuild)' != 'true'">
    <ItemGroup>
      <VueDistFiles Include="..\Emuera.Web\dist\**\*" />
    </ItemGroup>
    <Copy SourceFiles="@(VueDistFiles)"
          DestinationFolder="wwwroot\%(RecursiveDir)"
          SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(VueDistFiles)"
          DestinationFolder="$(OutputPath)wwwroot\%(RecursiveDir)"
          SkipUnchangedFiles="true" />
  </Target>

</Project>
