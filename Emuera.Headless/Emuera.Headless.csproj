<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <RootNamespace>MinorShift.Emuera</RootNamespace>
    <AssemblyName>Emuera.Headless</AssemblyName>
    <DefineConstants>HEADLESS</DefineConstants>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ServerGarbageCollection>true</ServerGarbageCollection>
    <PublishSingleFile>true</PublishSingleFile>
    <!-- I-12 阶段 1：质量护栏按路径分级
         - Emuera.Headless/Shared/** 历史共享源码警告由 .editorconfig 全局抑制（T-023 物理迁移自 Emuera/）
         - Emuera.Headless/** 自有源码保持警告可见，便于阶段 2 逐步收紧
         - 阶段 2（Nullable enable + TreatWarningsAsErrors）待 T-022 推进 -->
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisMode>Minimum</AnalysisMode>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>

  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Emuera.Headless.Tests" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="System.CommandLine" Version="2.0.9" />
    <!-- I-14 阶段 C：System.Drawing.Common 已彻底移除
         通过自定义 Emu 类型（EmuColor/EmuPoint/EmuRectangle/EmuSize/EmuFont/EmuFontStyle/EmuRectangleF）
         + 隐式转换桥接 + #if HEADLESS 条件编译隔离 GDI 代码 -->
  </ItemGroup>
  <!-- ===== 共享源码：Shared/ 子树（T-023 物理迁移自 Emuera/） ===== -->
  <!-- 历史 Runtime/UI/Game 源码由 SDK 默认 glob（**\*.cs）自动包含 -->
  <!-- WinForms/音频专用文件（Sound.WMP/NAudio/NAudio_LoopStream/WinInput/Clipboard、
       WinFormsConsole/StringMeasure/EmueraConsole*.cs）留在 Emuera/ 原处作只读参考 -->
  <!-- .editorconfig [Emuera.Headless/Shared/**] 抑制历史警告；T-022 后逐步清零并启用 nullable -->

  <!-- ===== GlobalStatic：Headless 专用实现（不共享 Emuera/GlobalStatic.cs） ===== -->
  <!-- I-02：单会话不可变全局硬约束 + setter 断言 + Reset 清理，见 Emuera.Headless/GlobalStatic.cs -->

  <!-- ===== 嵌入资源：语言文件（SDK 默认 glob 不含 .xml，需显式包含） ===== -->
  <ItemGroup>
    <EmbeddedResource Include="Shared\Properties\lang\emuera-eng.xml" LinkBase="Properties\lang" />
    <EmbeddedResource Include="Shared\Properties\lang\emuera-zhs.xml" LinkBase="Properties\lang" />
  </ItemGroup>

</Project>
