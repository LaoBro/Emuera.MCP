﻿﻿﻿﻿﻿﻿﻿﻿﻿﻿﻿﻿﻿﻿﻿﻿# 仓库根 .editorconfig
# I-12 阶段 1：质量护栏按路径分级
# - EraCore.Core/Shared/ 子树是 T-023 物理迁移自 Emuera/ 的历史共享源码
#   此处抑制其 CA 分析器噪音与 EvilMask 命名风格 CS8981，避免 Core 构建被历史代码警告淹没
# - EraCore.Core/ 自有源码（排除 Shared/）保持默认 AnalysisMode=Minimum 行为，新代码警告仍可见
# - 阶段 2（T-022）已逐步撤销本文件的抑制，启用 nullable + TreatWarningsAsErrors
#
# 注意：.NET 的 .editorconfig 不支持 `dotnet_analyzer_diagnostic.severity = none` 全局语法，
#       必须逐条列出 dotnet_diagnostic.<CAxxxx>.severity = none。
# issue 01 拆分：原 Emuera.Headless/ 路径全部改为 EraCore.Core/（Server/HttpSessionIO 等四文件
# 移入 EraCore.Server/，HeadlessRunner/ServerRunner/HeadlessOptions 移入 EraCore.Cli/）。

root = true

[*]
charset = utf-8-bom
end_of_line = crlf
indent_style = tab
indent_size = 4
tab_width = 4

# EvilMask 库命名风格：trerror / trmb / trsl / trmk / treer 等小写类型别名
# 此约定跨 Emuera / Emuera.Headless 共享，全局抑制
dotnet_diagnostic.CS8981.severity = none

# ===== EraCore.Core/Shared 历史共享源码（抑制已清零） =====
# T-023 物理迁移自 Emuera/。T-022 阶段 4 已将所有历史 CA/CS 抑制清零
# （含 CA1416 Shared 段 2026-07-08 方案 B 消除），当前 Shared/ 无残留抑制。
# 清理记录见 docs/2026.7.4.T-022阶段4-Shared历史警告清理/T-022阶段4-Shared历史警告清理.md
[EraCore.Core/Shared/**]

# ===== EraCore.Core 自有源码 =====
# T-022 阶段 3：Headless 模式固有警告抑制
# [EraCore.Core/**] 覆盖自有源码；[EraCore.Core/Shared/**] 更具体，优先于本段
[EraCore.Core/**]
# CA1416：Headless 自有代码 WindowsTerminalSetup.cs 使用 Console.BufferWidth/Window* 等 Windows 专用 API（自有代码 4 处）
dotnet_diagnostic.CA1416.severity = none
# CS0649：反射赋值或占位字段（tooltip_img/rikaichan 等）
dotnet_diagnostic.CS0649.severity = none

# CA1822：以下 5 个文件含实例方法空实现/ERB 函数 stub，改 static 会破坏调用约定
# 仅对这 5 个文件抑制，新代码的 CA1822 仍可见
[EraCore.Core/UI/Game/EmueraConsole.cs]
dotnet_diagnostic.CA1822.severity = none

[EraCore.Core/Headless/HeadlessClipboard.cs]
dotnet_diagnostic.CA1822.severity = none

[EraCore.Core/Headless/HeadlessSound.cs]
dotnet_diagnostic.CA1822.severity = none

[EraCore.Core/Terminal/AgentCliVtScreen.cs]
dotnet_diagnostic.CA1822.severity = none

[EraCore.Core/Terminal/TerminalCursor.cs]
dotnet_diagnostic.CA1822.severity = none

# CA1859：IProcessState state 属性有意用接口而非具体类型，Phase 3 解耦设计意图
[EraCore.Core/Shared/Runtime/Script/Process.SystemProc.cs]
dotnet_diagnostic.CA1859.severity = none

[EraCore.Core/Shared/Runtime/Script/Process.ScriptProc.cs]
dotnet_diagnostic.CA1859.severity = none
