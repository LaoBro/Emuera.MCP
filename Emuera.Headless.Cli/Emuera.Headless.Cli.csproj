<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <RootNamespace>MinorShift.Emuera</RootNamespace>
    <AssemblyName>Emuera.Headless.Cli</AssemblyName>
    <DefineConstants>HEADLESS</DefineConstants>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ServerGarbageCollection>true</ServerGarbageCollection>
    <PublishSingleFile>true</PublishSingleFile>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisMode>Minimum</AnalysisMode>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.CommandLine" Version="2.0.9" />
  </ItemGroup>

  <ItemGroup>
    <!-- Cli 引用 Core + Server：经 InternalsVisibleTo 访问 internal 成员
         （HeadlessRunner 调 GameLoopComposer.RunAsync / ServerRunner 调 KestrelGameServer 等）-->
    <ProjectReference Include="..\Emuera.Headless.Core\Emuera.Headless.Core.csproj" />
    <ProjectReference Include="..\Emuera.Headless.Server\Emuera.Headless.Server.csproj" />
  </ItemGroup>

  <!-- ===== issue 05 / spec ID13：Vue 前端构建 + 静态资源服务 =====
       Vue build/copy target 已抽到 build/VueBuild.targets，参数化：
         VueDistDestination（默认 wwwroot\）/ ViteBase（默认 /）
         VueOutDir（默认 dist）/ VueSrcDir（默认 ..\Emuera.Web）
       Cli 用默认值，MAUI Import 时覆盖 ViteBase=./ VueOutDir=dist-maui 避免争用。 -->
  <!-- wwwroot/ 文件随 build/publish 复制到输出目录。
       PublishSingleFile=true（PropertyGroup 上方）下 wwwroot 是松散文件目录，不嵌入 exe，
       必须作为独立文件随 exe 分发。
       wwwroot/ 由 .gitignore 排除（构建产物不入库），由 VueBuild.targets 填充。
       注意：Content glob 在 project load 时评估，首次 build 时 wwwroot/ 尚为空，
       CopyVueFrontendToWwwroot target 内会直接 Copy 到 $(OutputPath)wwwroot/ 作为兜底。 -->
  <ItemGroup>
    <Content Include="wwwroot\**\*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <Import Project="..\build\VueBuild.targets" />

</Project>
